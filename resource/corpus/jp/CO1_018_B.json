  "texts": [
    {
      "lng_idx": 1,
      "text": "「あげはかな」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 2,
      "text": "「……なんか違う」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 3,
      "text": "「はい？」%K%P",
      "text_with_name": "%LCあげは「はい？」%K%P",
      "char_name": "あげは"
    },
    {
      "lng_idx": 4,
      "text": "「碧って、女の子の水着褒めるのに、\\n　そんなさらっとしてないよね？」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 5,
      "text": "「……褒めた経験が今までなかったから、\\n　そんなこと知らん」%K%P",
      "text_with_name": "%LCあげは「……褒めた経験が今までなかったから、\\n　そんなこと知らん」%K%P",
      "char_name": "あげは"
    },
    {
      "lng_idx": 6,
      "text": "「絶対ちがうよ！\\n　試しに、天音先輩の水着褒めてみて」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 7,
      "text": "「う……いや、えぇと……お似合いですよ先輩」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 8,
      "text": "「ありがとう」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 9,
      "text": "「ほらほらー、すっごい照れてるじゃーん！\\n　なんでわたしの時は照れないかなぁ！」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 10,
      "text": "「知るかっ！\\n　幼なじみだからだろっ！」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 11,
      "text": "「うー、損だなぁ、幼なじみって」%K%P",
      "text_with_name": null,
      "char_name": null
    }
  ]
}