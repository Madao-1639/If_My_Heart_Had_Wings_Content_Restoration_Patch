{
  "script": "CO1_016_D",
  "source": "Rio.arc",
  "total": 23,
  "texts": [
    {
      "lng_idx": 0,
      "text": "「……あの、どうしてそう思ったんですか？」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 1,
      "text": "なんで急にそんなこと言い出したんだろう。%K%P",
      "text_with_name": "%LC碧なんで急にそんなこと言い出したんだろう。%K%P",
      "char_name": "碧"
    },
    {
      "lng_idx": 2,
      "text": "「お風呂に入ってる時にな、\\n　小鳥とあげはが言ってたんだ」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 3,
      "text": "「碧くんが好きなのは私じゃないかって」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 4,
      "text": "なんだそれ。%K%P",
      "text_with_name": "%LC天音なんだそれ。%K%P",
      "char_name": "天音"
    },
    {
      "lng_idx": 5,
      "text": "「……まるで、俺が誰かに片思いしている事実は、\\n　確定しているような言い草っすね」%K%P",
      "text_with_name": "%LC天音「……まるで、俺が誰かに片思いしている事実は、\\n　確定しているような言い草っすね」%K%P",
      "char_name": "天音"
    },
    {
      "lng_idx": 6,
      "text": "「それで、本人に聞いてみようと思ったわけですか」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 7,
      "text": "先輩は、素朴な表情を浮かべて、こくんと頷く。%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 8,
      "text": "それ、聞いちゃいけないだろう、本人に。%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 9,
      "text": "「そうかぁ、そうなのかぁ……」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 10,
      "text": "先輩はぶつくさ言いながら、図面へと視線を戻した。%K%P",
      "text_with_name": "%LC天音先輩はぶつくさ言いながら、図面へと視線を戻した。%K%P",
      "char_name": "天音"
    },
    {
      "lng_idx": 11,
      "text": "一瞬でまた、集中した顔になる。%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 12,
      "text": "麦茶を飲み終えた俺は、立ち上がって、グラスを流しにおいた。%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 13,
      "text": "「それじゃ俺、もう寝ますんで」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 14,
      "text": "「……」%K%P",
      "text_with_name": "%LC碧「……」%K%P",
      "char_name": "碧"
    },
    {
      "lng_idx": 15,
      "text": "聞こえちゃいねぇ……。%K%P",
      "text_with_name": "%LC天音聞こえちゃいねぇ……。%K%P",
      "char_name": "天音"
    },
    {
      "lng_idx": 16,
      "text": "扇風機をそっと先輩の方へ向けると、俺は食堂を出た。%K%P",
      "text_with_name": "%LC天音扇風機をそっと先輩の方へ向けると、俺は食堂を出た。%K%P",
      "char_name": "天音"
    },
    {
      "lng_idx": 17,
      "text": "「……はぁ、ドキドキした～」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 18,
      "text": "後ろ手に閉めたドアを背に、左胸に手を当てる。%K%P",
      "text_with_name": "%LC碧後ろ手に閉めたドアを背に、左胸に手を当てる。%K%P",
      "char_name": "碧"
    },
    {
      "lng_idx": 19,
      "text": "まだ心臓がバクバクいってる。%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 20,
      "text": "「急にあんな質問するんだもんな……」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 21,
      "text": "あんなキレイな人に、面と向かって「好きなのか？」なんて言われたら、好きかどうかなんて関係なく、ちょっとときめいてしまうものがあった。%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 22,
      "text": "俺はベッドに横になるものの、高鳴る心臓は、しばらく治まってはくれそうになかった。%K%P",
      "text_with_name": null,
      "char_name": null
    }
  ]
}