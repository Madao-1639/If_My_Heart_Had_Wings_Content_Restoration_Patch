{
  "script": "CO1_018_C",
  "source": "Rio.arc",
  "total": 13,
  "texts": [
    {
      "lng_idx": 1,
      "text": "「天音先輩が……一番似合ってると思う」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 2,
      "text": "俺が、若干赤くなりながら答えると、他の二人がじとっと睨んでくる。%K%P",
      "text_with_name": "%LC碧俺が、若干赤くなりながら答えると、他の二人がじとっと睨んでくる。%K%P",
      "char_name": "碧"
    },
    {
      "lng_idx": 3,
      "text": "「ふぅん」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 4,
      "text": "「やっぱりだ」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 5,
      "text": "「な、なんだよ」%K%P",
      "text_with_name": "%LC小鳥「な、なんだよ」%K%P",
      "char_name": "小鳥"
    },
    {
      "lng_idx": 6,
      "text": "「いま、天音ちゃんのムネ見てたでしょ！\\n　いやらしいっ」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 7,
      "text": "「胸？」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 8,
      "text": "「なっ……」%K%P",
      "text_with_name": "%LC天音「なっ……」%K%P",
      "char_name": "天音"
    },
    {
      "lng_idx": 9,
      "text": "しょうがないだろっ！\\n水着を見るってことはそこを見ることなんだからっ！！%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 10,
      "text": "「（……天音先輩って、脱ぐとスゴイんだな！）」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 11,
      "text": "思わず二度見してしまったところで先輩と目が合った。%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 12,
      "text": "「ふふ、ありがとう。\\n　なんだかくすぐったいな」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 13,
      "text": "嬉しそうに素朴な笑みを返してこられて、罪悪感に駆られるのだった。%K%P",
      "text_with_name": "%LC天音嬉しそうに素朴な笑みを返してこられて、罪悪感に駆られるのだった。%K%P",
      "char_name": "天音"
    }
  ]
}