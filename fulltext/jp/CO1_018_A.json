    {
      "lng_idx": 1,
      "text": "「……小鳥、かな」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 2,
      "text": "「……！！？」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 3,
      "text": "小鳥がびくっとして、瞬時に真っ赤になる。%K%P",
      "text_with_name": "%LC小鳥小鳥がびくっとして、瞬時に真っ赤になる。%K%P",
      "char_name": "小鳥"
    },
    {
      "lng_idx": 4,
      "text": "「よかったじゃないか、小鳥。\\n　碧くんが褒めてくれたぞ」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 5,
      "text": "「しゃーないかぁ、小鳥可愛いもんね～」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 6,
      "text": "「あぅあぅ……え、エッチな目で見ないでっ！」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 7,
      "text": "「なんだその返しはっ！？」%K%P",
      "text_with_name": "%LC小鳥「なんだその返しはっ！？」%K%P",
      "char_name": "小鳥"
    },
    {
      "lng_idx": 8,
      "text": "これじゃ、褒め損じゃないかっ！%K%P",
      "text_with_name": "%LC碧これじゃ、褒め損じゃないかっ！%K%P",
      "char_name": "碧"
    },
    {
      "lng_idx": 9,
      "text": "「まあまあ、小鳥ちゃんなりに、\\n　照れ隠ししてんのよ♪」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 10,
      "text": "「うぅぅ……」%K%P",
      "text_with_name": null,
      "char_name": null
    },
    {
      "lng_idx": 11,
      "text": "小鳥は、真っ赤な顔したまま俯いてしまった。%K%P",
      "text_with_name": "%LC小鳥小鳥は、真っ赤な顔したまま俯いてしまった。%K%P",
      "char_name": "小鳥"
